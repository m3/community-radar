# CommunityRadar — local environment template
#
# Source-of-truth model:
#   - Secrets       → Bitwarden Secrets (BWS), project `persona-glenn`
#   - Local config  → this file copied to `.env` (non-secret values only)
#
# `.env` is gitignored. It should hold only local, non-secret config.
#
# Deploy with BWS-injected secrets via the wrapper:
#   scripts/deploy.sh                  # docker compose up -d
#   scripts/deploy.sh logs -f          # passes any subcommand through
#
# The wrapper reads BWS_ACCESS_TOKEN from the shell and injects secrets from
# the persona-glenn project. Requires `bws` on PATH.

# --- Local config (safe defaults) ---

# Docker Postgres (bound to 127.0.0.1 only)
POSTGRES_USER=community_radar
POSTGRES_PASSWORD=password123
POSTGRES_DB=community_radar

# Password for the non-superuser runtime role (radar_app) that the backend and
# worker connect as. Tenant isolation is enforced by Postgres row-level
# security, so runtime must NOT use the superuser owner. The `migrate` service
# sets this on the role; backend/worker use it to connect. Use a real secret in
# production (BWS); this dev default only exists for local docker.
RADAR_APP_PASSWORD=radar_app_dev

# --- Secrets — DO NOT put in .env. Stored in BWS `persona-glenn` project ---
# These are injected by `scripts/deploy.sh` via `bws run`.
#
# DISCORD_TOKEN
# REDDIT_SESSION
# RADAR_APP_PASSWORD  (production value)
